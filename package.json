{
  "name": "nas-status",
  "version": "1.0.0",
  "description": "A status page for Nextcloud, powered by the serverinfo external monitoring API. Runs on Cloudflare Workers or Node.js.",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "license": "MIT",
  "author": "Liam Burnett",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server.js",
    "demo": "node server.js --demo",
    "test": "node --test test/*.test.js",
    "build:preview": "node scripts/build-preview.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
