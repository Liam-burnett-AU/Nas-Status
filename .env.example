# ---------------------------------------------------------------------------
# NAS Status configuration for the Node.js / Docker version. Copy to .env.
# (On Cloudflare Workers, use wrangler.jsonc and `wrangler secret put` instead.)
# ---------------------------------------------------------------------------

# --- Required ----------------------------------------------------------------
# Base URL of your Nextcloud, including any sub-path (no trailing slash needed).
NEXTCLOUD_URL=https://cloud.example.com

# serverinfo monitoring token. Create one on the Nextcloud server with:
#   sudo -u www-data php occ config:app:set serverinfo token --value "$(openssl rand -hex 32)"
NEXTCLOUD_TOKEN=

# --- Optional: admin app password -------------------------------------------
# Unlocks disk volumes, server uptime and temperatures (admin-only endpoints).
# Use an app password (Personal settings > Security), never your real password.
# NEXTCLOUD_USER=admin
# NEXTCLOUD_APP_PASSWORD=

# --- Optional: Cloudflare Access service token -------------------------------
# Only if Nextcloud is protected by Cloudflare Access.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# --- Page --------------------------------------------------------------------
SITE_TITLE=NAS Status
SITE_DESCRIPTION=Live health, performance and uptime for our Nextcloud server.
# IANA time zone used for daily uptime bars and all displayed times.
TIMEZONE=Australia/Brisbane
# Show versions, PHP, database and caching details publicly (true/false).
SHOW_SERVER_DETAILS=true

# --- Monitoring --------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
# Consecutive failed/degraded checks before an incident is opened (and good checks before it closes).
INCIDENT_THRESHOLD=2

# --- Thresholds --------------------------------------------------------------
RESPONSE_DEGRADED_MS=1500
API_DEGRADED_MS=5000
CPU_DEGRADED_PERCENT=90
MEMORY_DEGRADED_PERCENT=90
# Used when the data volume size is known (requires the admin app password).
DISK_WARN_PERCENT=85
DISK_CRITICAL_PERCENT=95
# Used when only free space is known (token only).
DISK_WARN_FREE_GB=50
DISK_CRITICAL_FREE_GB=10

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
DATA_DIR=./data
LOG_LEVEL=info

# --- Other apps ----------------------------------------------------------------
# JSON array, one line. url "" shows the app as "Not set up".
# SERVICES=[{"name":"Logbook","url":"https://logbook.example.com"},{"name":"Login API","url":"https://api.example.com/health","expectStatus":[200]}]

# Preview the page with generated data, no Nextcloud needed.
DEMO_MODE=false
